<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="Comment on Success" field="commentOnSuccess">
        <f:checkbox default="false"/>
    </f:entry>
    <f:entry title="Custom Comment" field="customComment">
        <f:checkbox default="false"/>
    </f:entry>
    <f:entry title="Comment File" field="commentFile">
        <f:textbox/>
    </f:entry>
    <f:entry title="Comment Size" field="commentSize">
        <f:textbox/>
    </f:entry>
    <f:entry title="Comment with Console Link on Failure" field="commentWithConsoleLinkOnFailure">
        <f:checkbox default="false"/>
    </f:entry>
    <f:entry title="Uberalls Enabled" field="uberallsEnabled">
        <f:checkbox default="false"/>
    </f:entry>
    <f:entry title="Coverage Check" field="coverageCheck">
        <f:checkbox default="false"/>
    </f:entry>
    <f:entry title="Coverage Threshold" field="coverageThreshold">
        <f:textbox default="0.0"/>
    </f:entry>
    <f:entry title="Min Coverage Threshold" field="minCoverageThreshold">
        <f:textbox default="0.0"/>
    </f:entry>
    <f:entry title="Coverage Report Pattern" field="coverageReportPattern">
        <f:textbox/>
    </f:entry>
    <f:entry title="Preserve Formatting" field="preserveFormatting">
        <f:checkbox default="true"/>
    </f:entry>
    <f:entry title="Process Lint" field="processLint">
        <f:checkbox default="false"/>
    </f:entry>
    <f:entry title="Lint File" field="lintFile">
        <f:textbox/>
    </f:entry>
    <f:entry title="Lint File Size" field="lintFileSize">
        <f:textbox/>
    </f:entry>
    <f:entry title="Send Partial Results" field="sendPartialResults">
        <f:checkbox default="false"/>
    </f:entry>
</j:jelly>
