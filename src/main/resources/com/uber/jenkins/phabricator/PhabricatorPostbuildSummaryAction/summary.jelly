<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:t="/lib/hudson">
  <t:summary icon="${it.iconPath}">
    <div class="jenkins-card">
      <div class="jenkins-card__content">
        <div class="jenkins-card__title">
          Phabricator Differential
        </div>
        <div class="jenkins-!-padding-1">
          This was a build of <a class="jenkins-link--with-icon" href="${it.url}">${it.revisionID}</a>
          by ${it.authorName}

          <j:if test="${it.authorEmail != null}">
            (${it.authorEmail})
          </j:if>
        </div>

        <j:if test="${it.commitMessage != null}">
          <pre class="jenkins-!-margin-0">${it.commitMessage}</pre>
        </j:if>
      </div>
    </div>
  </t:summary>
</j:jelly>
