<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core">
    <j:if test="${it.iconPath != null &amp;&amp; it.link == null}">
        <span class="jenkins-badge" title="${it.text}">
            <img src="${rootURL}${it.iconPath}" width="16" height="16" alt="${it.text}" />
        </span>
    </j:if>
    <j:if test="${it.iconPath != null &amp;&amp; it.link != null}">
        <a class="jenkins-badge" href="${it.link}" title="${it.text}">
            <img src="${rootURL}${it.iconPath}" width="16" height="16" alt="${it.text}" />
        </a>
    </j:if>
    <j:if test="${it.iconPath == null &amp;&amp; it.link != null}">
        <a class="jenkins-badge" href="${it.link}" title="${it.text}">
            ${it.text}
        </a>
    </j:if>
    <j:if test="${it.iconPath == null &amp;&amp; it.link == null}">
        <span class="jenkins-badge" title="${it.text}">${it.text}</span>
    </j:if>
</j:jelly>
